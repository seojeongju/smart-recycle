{
  "name": "smart-recycle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply smart-recycle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply smart-recycle-db --remote",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add smart-recycle-images expire-recognition-uploads uploads/ --expire-days 7 --force && wrangler r2 bucket lifecycle add smart-recycle-images expire-checkin-photos checkins/ --expire-days 90 --force"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
